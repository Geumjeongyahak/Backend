# 부하 측정용 앱 환경 (dev 프로필). 비밀값은 전부 이 측정에서만 쓰는 더미다.
# 외부 연동(GCP Storage · Drive · 메일 · Firebase · Google 로그인)은 측정 경로에 없어 끄거나 더미로 둔다.
SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9090
POSTGRES_HOST=__DB_HOST__
POSTGRES_PORT=5432
POSTGRES_DB=geumjeongyahak
POSTGRES_USER=gj
POSTGRES_PASSWORD=gj
FLYWAY_ENABLED=true
ADMIN_BOOTSTRAP_ENABLED=false
JWT_SECRET=bG9hZHRlc3QtMjIxLWR1bW15LXNlY3JldC1rZXktZm9yLWhzNTEyLXNpZ25pbmctb25seS0wMTIzNDU2Nzg5YWJjZGVm
JWE_SECRET=bG9hZHRlc3QtMjIxLWR1bW15LWp3ZS1zZWNyZXQtMDEyMzQ1Njc4OWFiY2RlZg==
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_REDIRECT_URI=http://localhost/dummy
FRONTEND_REDIRECT_URI=http://localhost/dummy
GCP_PROJECT_ID=dummy
GCP_DEV_BUCKET_NAME=dummy
# run.sh 가 임의 RSA 키로 만든 더미 서비스 계정 JSON(base64)을 넣는다. 네트워크 호출 없이 Storage 빈 생성만 통과시킨다
GCP_ENCODED_CREDENTIALS=__FAKE_SA__
SPRING_AUTOCONFIGURE_EXCLUDE=com.google.cloud.spring.autoconfigure.firestore.GcpFirestoreAutoConfiguration
MAIL_ENABLED=false
MAIL_FALLBACK_TO_LOG=true
FIREBASE_ENABLED=false
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=WARN
LOG_LEVEL_SQL=WARN
HIBERNATE_GENERATE_STATISTICS=false
